# Copy this file to .env and put your own token in it. Do not commit .env.
#
# NOTE: the server itself does NOT read this file. An MCP client passes the
# environment in, so put the token in the client configuration. This file is
# read by `npm run smoke` and by `node --env-file=.env dist/index.js`.
#
# Get a token in monday.com:
#   Avatar (bottom left) > Developers > My access tokens > Show
# Or, for an account-wide token:
#   Avatar > Administration > API > Personal API token
MONDAY_API_TOKEN=

# Optional. The monday.com API version the server asks for.
# MONDAY_API_VERSION=2026-07

# Optional. Set to 1 to block every write tool. Read tools still work.
# MONDAY_READ_ONLY=1

# Optional. Restrict the server to these board ids, comma separated.
# Every other board becomes invisible to the model.
# MONDAY_ALLOWED_BOARDS=1234567890,9876543210

# Optional. Different endpoint, for a proxy or a test double.
# MONDAY_API_URL=https://api.monday.com/v2
