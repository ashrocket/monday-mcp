# Copy to .env for local smoke checks, and keep the real .env uncommitted.
# The MCP server does not read .env automatically. Pass these values through
# your MCP client's environment, or use Node's --env-file option for local runs.
#
# Personal API token: monday.com profile picture (top right) > Developers >
# API token > Show. Account admins can also find their Personal API token at
# Administration > Connections > Personal API token.
# Current token and permission guidance:
# https://developer.monday.com/api-reference/docs/authentication
# Personal tokens mirror the user's monday.com permissions. Prefer a credential
# with only the upstream permissions this integration needs.
MONDAY_API_TOKEN=

# Optional. monday.com API version requested by this server.
# MONDAY_API_VERSION=2026-07

# Optional. Block all API mutations. Accepted boolean forms are true/false,
# yes/no, on/off, and 1/0. Malformed boolean values stop startup.
# MONDAY_READ_ONLY=1

# Optional. Restrict board-scoped API tools to numeric board ids.
# When set, raw GraphQL and integrated browser/desktop access are disabled.
# Account-level tools may still return metadata. Omit this variable entirely
# for unrestricted board scope; an empty list is rejected.
# MONDAY_ALLOWED_BOARDS=1234567890,9876543210

# Optional. Enable the dedicated background Chrome browser alongside API tools.
# Login state is credential material. Create it with:
# node dist/index.js --browser-login --account-slug <slug> --browser-state /Users/<your-user>/.config/monday/work.storage-state.json
# Keep the *.storage-state.json file private and outside the repository.
# MONDAY_BROWSER=1
# MONDAY_BROWSER_STATE=/Users/<your-user>/.config/monday/work.storage-state.json

# Optional. Browser-only operation needs no API token; set the account slug and
# a state snapshot created with --browser-login as above.
# MONDAY_BROWSER_ONLY=1
# MONDAY_ACCOUNT_SLUG=your-account-subdomain

# Optional. Use a different compatible Chrome/Chromium executable.
# MONDAY_BROWSER_EXECUTABLE=/path/to/chrome
# MONDAY_BROWSER_TIMEOUT_MS=60000

# Optional. Legacy desktop-only mode attaches to the running monday.com desktop
# app over its local, unauthenticated debug port. This does not use the browser
# state snapshot. Do not enable with a board allow list.
# MONDAY_DESKTOP_ONLY=1
# MONDAY_DEBUG_PORT=9222

# Optional. Different GraphQL endpoint, for a proxy or test double.
# MONDAY_API_URL=https://api.monday.com/v2

# Optional retry/timeout settings for API requests.
# MONDAY_TIMEOUT_MS=30000
# MONDAY_MAX_RETRIES=3

# monday.com rate limits vary by token/account and can change. See:
# https://developer.monday.com/api-reference/docs/rate-limits
