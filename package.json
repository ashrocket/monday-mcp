{
  "name": "@ashrocket/monday-mcp",
  "version": "0.2.0",
  "description": "Unofficial local Model Context Protocol server for the monday.com API. Runs on your machine, talks straight to monday.com, keeps your token local.",
  "license": "MIT",
  "author": "Ashley Raiteri",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "monday-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashrocket/monday-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ashrocket/monday-mcp/issues"
  },
  "homepage": "https://github.com/ashrocket/monday-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "monday",
    "monday.com",
    "claude",
    "llm",
    "graphql"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/make-executable.mjs",
    "prepare": "npm run build",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
